@@ -234,41 +234,41 @@ reg copjmp1, copjmp2;
 always @(posedge clk)
   if (clk7_en) begin
   	if (reg_address_in[8:1]==COPJMP1[8:1] || sof)
-  		copjmp1 = 1;
+  		copjmp1 <= 1;
   	else if (clk_ena)
-  		copjmp1 = 0;
+  		copjmp1 <= 0;
   end
 
 always @(posedge clk)
   if (clk7_en) begin
   	if (reg_address_in[8:1]==COPJMP2[8:1])
-  		copjmp2 = 1;
