diff --git a/rtl/minimig/cpu_cache_new.sv b/rtl/minimig/cpu_cache_new.sv
index 76c789d..e50b373 100644
--- a/rtl/minimig/cpu_cache_new.sv
+++ b/rtl/minimig/cpu_cache_new.sv
@@ -239,7 +239,13 @@ localparam [3:0]
 	CPU_SM_FILL3 = 4'd8,
 	CPU_SM_FILL4 = 4'd9,
 	CPU_SM_FILLW = 4'd10,
-	CPU_SM_INVAL = 4'd11;
+	CPU_SM_INVAL = 4'd11,
+	CPU_SM_DRAIN = 4'd12;   // Game Bub port: the rest of an uncached burst
+
+// Game Bub port: an uncached read takes the first word of the SDRAM's four
+// word burst; the other three still arrive (sdr_read_ack) and must not be
+// taken as the answer to the next read
+reg   [1:0] drain_cnt;
 
 assign cpu_idle = (cpu_sm_state == CPU_SM_IDLE);
 
@@ -456,7 +462,8 @@ always @ (posedge clk) begin
           cpu_ack <= 1'b1;
           if (cache_inhibit || (!cpu_ir && !cc_den)) begin
             fill_active  <= 1'b0;
-            cpu_sm_state <= CPU_SM_FILLW;
+            drain_cnt    <= 2'd3;
+            cpu_sm_state <= CPU_SM_DRAIN;
           end else begin
             // update tag ram
             if (cpu_ir) begin
@@ -541,6 +548,12 @@ always @ (posedge clk) begin
           end
         end
       end
+      CPU_SM_DRAIN : begin
+        if (sdr_read_ack) begin
+          drain_cnt <= drain_cnt - 2'd1;
+          if (drain_cnt == 2'd1) cpu_sm_state <= CPU_SM_FILLW;
+        end
+      end
       CPU_SM_INVAL : begin
         inv_sel      <= 1'b0;
         fill_active  <= 1'b0;
diff --git a/rtl/minimig/cpu_wrapper.sv b/rtl/minimig/cpu_wrapper.sv
index c60357d..2fbf46c 100644
--- a/rtl/minimig/cpu_wrapper.sv
+++ b/rtl/minimig/cpu_wrapper.sv
@@ -92,7 +92,7 @@ module cpu_wrapper
 	output reg [31:0] nmi_addr,
 
 	output reg        z2ram_ena,
-	output reg  [4:0] z3ram_base0,
+	output reg  [7:0] z3ram_base0,   // Game Bub port: 16 MB units
 	output reg        z3ram_ena0,
 	output reg  [3:0] z3ram_base1,
 	output reg        z3ram_ena1,
@@ -775,7 +775,9 @@ always @(*) begin
 	else if(ac_memcard[2]) begin
 		case (chip_addr[6:1])
 			6'b000000: autocfg_data = 4'b1010;	// Zorro-III card, add mem, no ROM
-			6'b000001: autocfg_data = ac_memcard[1] ? 4'b0011 : 4'b0100; // 128MB or 256MB, extended
+			// Game Bub port: the 128 MB board is a 16 MB board (in the
+			// second SDRAM chip), extended size code 000
+			6'b000001: autocfg_data = ac_memcard[1] ? 4'b0000 : 4'b0100; // 16MB or 256MB, extended
 			6'b000010: autocfg_data = 4'b1110;	// ProductID=0x10 (only setting upper nibble)
 			6'b000100: autocfg_data = 4'b0000;	// Memory card, not silenceable, Extended size, reserved.
 			6'b000101: autocfg_data = 4'b1111;	// 0000 - logical size matches physical size TODO change this to 0001, so it is autosized by the OS, WHEN it will be 24MB.
@@ -860,7 +862,7 @@ always @(posedge clk) begin
 					ac_memcard <= {ac_memcard[0], ac_memcard[0], 1'b0};
 				end
 				else begin
-					z3ram_base0 <= cpu_dout[15:11]; //128MB chunk
+					z3ram_base0 <= cpu_dout[15:8]; //16MB chunk (Game Bub port)
 					z3ram_ena0 <= 1;
 					ac_memcard <= 0;
 				end
