+	input         nmi_ack_toggle, // flips at every level-7 acknowledge of a CPU that makes no acknowledge cycle (else 0)
 
 	//sram pins
 	output [15:0] ram_data,    // sram data bus
@@ -894,6 +895,7 @@
   .freeze(freeze),
