diff --git a/rtl/minimig/memory_router.sv b/rtl/minimig/memory_router.sv
index 0c71e78..0b33e40 100644
--- a/rtl/minimig/memory_router.sv
+++ b/rtl/minimig/memory_router.sv
@@ -27,7 +27,6 @@ module memory_router
 	output        sel_z3ram0,
 	output        sel_z3ram1,
 	output        sel_zram,
-	output        sel_dd,
 	output        sel_rtg,
 
 	output [28:1] ramaddr
@@ -37,7 +36,6 @@ assign sel_z3ram0   = (cpu_addr[31:24] == z3ram_base0) && z3ram_ena0;
 assign sel_z3ram1   = (cpu_addr[31:28] == z3ram_base1) && z3ram_ena1;
 assign sel_z2ram    = !cpu_addr[31:24] && (cpu_addr[23] ^ |cpu_addr[22:21]) && z2ram_ena; // addr[23:21] = 1..4
 assign sel_zram     = sel_z3ram0 | sel_z3ram1 | sel_z2ram;
