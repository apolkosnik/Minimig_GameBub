   /// (n + 1) / 3, (n + 1) / 3 and the remaining bits of red, green and blue
   /// (10 bits: 3, 3, 2).
   val paletteBits: Int = 0,
+  /// If true, the core can show a picture of its own on HDMI in place of
+  /// the frame buffers (a display of any size kept in the core's memory):
+  /// `external`.
+  val externalPicture: Boolean = false,
 ) extends Bundle {
   require(paletteBits == 0 || paletteBits == colorDepthR + colorDepthG + colorDepthB)
   val data = Output(ColorRGB.apply(colorDepthR, colorDepthG, colorDepthB))
@@ -56,4 +60,26 @@ class VideoV0(
     val index = UInt(paletteBits.W)
     val color = UInt(24.W)
   })) else None
+  /// With `externalPicture`. All but `enable` are in the domain of `clock`,
+  /// the HDMI pixel clock. While `active` (HDMI is shown, 1280 x 720), `x`
+  /// and `y` name a pixel of the 1650 x 750 frame in every clock (x of
+  /// 1280 and above, y of 720 and above: blanking), and `color` must be
+  /// that pixel's colour (red 23:16, green 15:8, blue 7:0) exactly
+  /// `VideoV0.externalLatency` clocks later. While `enable` (the core's
+  /// clock domain) is high and HDMI is shown, `color` is shown on the
+  /// whole screen (the framework's menu overlay on top) and the frame
+  /// buffers are not.
+  val external = if (externalPicture) Some(new Bundle {
+    val clock = Input(Clock())
+    val active = Input(Bool())
+    val x = Input(UInt(11.W))
+    val y = Input(UInt(10.W))
+    val color = Output(UInt(24.W))
+    val enable = Output(Bool())
+  }) else None
+}
+
+object VideoV0 {
+  /// Clocks from `external.x` / `external.y` to that pixel's `external.color`.
+  val externalLatency = 12
 }
