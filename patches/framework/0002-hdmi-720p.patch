diff --git a/verilog/handheld/common.xdc b/verilog/handheld/common.xdc
index c9727d6..518e448 100644
--- a/verilog/handheld/common.xdc
+++ b/verilog/handheld/common.xdc
@@ -45,3 +45,9 @@ set_clock_groups -name exclusive_dpi_hdmi -physically_exclusive \
 # after changing, which we don't care about.
 set_false_path -setup -hold -to [get_pins -hierarchical *bufgmux_av/S0]
 set_false_path -setup -hold -to [get_pins -hierarchical *bufgmux_av/S1]
+
+# While the HDMI clock drives clk_av, HandheldTop holds the display driver in
+# reset (dpiDriver.reset when hdmiEnable): its registers do not change at that
+# clock, and the display branch of the framebuffer address is not selected.
+set_false_path -from [get_clocks -of_objects [get_pins -hierarchical *bufgmux_av/I1]] \
+    -through [get_pins -of_objects [get_cells -hierarchical -filter {IS_SEQUENTIAL && NAME =~ handheld_top/driver/*}] -filter {REF_PIN_NAME == Q}]
