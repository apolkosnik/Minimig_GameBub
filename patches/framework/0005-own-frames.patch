     val active = Input(Bool())
+    val hdmi = Input(Bool())
     val x = Input(UInt(11.W))
     val y = Input(UInt(10.W))
+    val sync = Input(Bool())
+    val frame = Input(UInt(1.W))
     val color = Output(UInt(24.W))
     val enable = Output(Bool())
   }) else None
+  /// With `ownFrames` (the core's clock domain): the frame (0 or 1) that
