@@ -17,9 +17,43 @@ class VideoV0(
   val colorDepthB: Int,
   /// Target frame period, in seconds.
   val framePeriod: Double,
+  /// If true, the video is scaled onto the screen in each direction
+  /// separately (pixels that are not square): across by the largest whole
+  /// factor that fits, down by the whole factor nearest to screen height /
+  /// video height, showing as many of the video's lines from its first as
+  /// the screen has room for (640 x 256 on a 480 line screen: 640 x 480,
+  /// the first 240 lines twice each), or, while `fit` is high, all of its
+  /// lines over the whole screen height (lines repeated unevenly). If
+  /// false, by the same factor in both directions.
+  val independentScale: Boolean = false,
+  /// If not 0, `data` is not a colour but an index of this many bits (r in
+  /// its top bits, then g, then b; the colour depths must add up to it)
+  /// into a palette of 24 bit colours that the core fills through
+  /// `palette`. The frame buffers hold the indices; the palette is looked
+  /// up as they are shown, so an entry must keep its colour for as long as
+  /// a frame that uses it may be on screen (a few frames after its last
+  /// use). The top quarter of the indices is a fixed set that is not in the
+  /// palette: with the top two index bits set, the rest is a colour of
+  /// (n + 1) / 3, (n + 1) / 3 and the remaining bits of red, green and blue
+  /// (10 bits: 3, 3, 2).
+  val paletteBits: Int = 0,
 ) extends Bundle {
+  require(paletteBits == 0 || paletteBits == colorDepthR + colorDepthG + colorDepthB)
   val data = Output(ColorRGB.apply(colorDepthR, colorDepthG, colorDepthB))
   val dataEnable = Output(Bool())
   val vblank = Output(Bool())
   val hblank = Output(Bool())
+  /// With `independentScale`: show all of the video's lines over the whole
+  /// screen height (may change between frames).
+  val fit = if (independentScale) Some(Output(Bool())) else None
+  /// With `paletteBits`: writes a palette entry (index, 24 bit colour: red
+  /// in bits 23:16, green 15:8, blue 7:0) in any clock that `write` is high.
+  /// While `enable` is low the frame buffers hold colours after all, of the
+  /// colour depths given (may change between frames).
+  val palette = if (paletteBits > 0) Some(Output(new Bundle {
+    val enable = Bool()
+    val write = Bool()
+    val index = UInt(paletteBits.W)
+    val color = UInt(24.W)
+  })) else None
 }
