+wire  [2:0] f_bytes = mem_line ? 3'd4 : size_bytes(mem_size);
+wire [31:0] f_addr  = mem_line ? {mem_addr[31:2], 2'b00} : mem_addr;
+wire [31:0] f_wd    = mem_line ? lw(mem_wline, mem_addr[3:2]) : mem_wdata;
+wire [31:0] f_wsh   = mem_line ? f_wd :
